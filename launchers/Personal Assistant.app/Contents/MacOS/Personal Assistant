#!/bin/zsh
set -eu

project_dir="${0:A:h:h:h:h:h}"
if [[ ! -f "$project_dir/pyproject.toml" ]]; then
    project_dir="$HOME/Projects/Local-assistant/personal-assistant"
fi
uv_path=""
for candidate in "$HOME/.local/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
    if [[ -x "$candidate" ]]; then
        uv_path="$candidate"
        break
    fi
done

if [[ -z "$uv_path" ]]; then
    /usr/bin/osascript -e 'display alert "Personal Assistant could not start" message "uv was not found in a standard installation location."'
    exit 1
fi

if [[ ! -f "$project_dir/pyproject.toml" ]]; then
    /usr/bin/osascript -e 'display alert "Personal Assistant could not start" message "The development project folder could not be found."'
    exit 1
fi

cd "$project_dir"
exec "$uv_path" run --locked personal-assistant-ui >/dev/null 2>&1
